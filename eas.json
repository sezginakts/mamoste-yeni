{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "ogretmen" },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "ogretmen" },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "ogretmen" }
    },
    "ogrenci-preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "ogrenci" },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ogrenci-production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "ogrenci" }
    }
  },
  "submit": {
    "production": {},
    "ogrenci-production": {}
  }
}
